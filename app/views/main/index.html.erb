<div class="container">
  <h1>癒されたいあなたへ</h1>

  <div class="message">
    <p><%= @greeting %></p>
    <p><%= @message %></p>
  </div>

  <%= form_with url: favorites_path, method: :post do %>
    <%= hidden_field_tag :message, @message %>
    <%= submit_tag "お気に入りに登録" %>
  <% end %>

  <form method="get" action="/main/index">
    <button type="submit">癒しをもらう</button>
  </form>

  <%= button_to "メニューに戻る", root_path, method: :get %>
</div>